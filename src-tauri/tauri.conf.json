{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plateforce",
  "identifier": "fit.saturday.plateforce",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "bash scripts/build-web.sh release",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "plateforce",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Force-plate kinetics, with the method attached to every number",
    "longDescription": "Reads a force trace, computes the variables the field reports, and records which published method produced each one.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}

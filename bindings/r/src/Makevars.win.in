TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/@LIBDIR@
STATLIB = $(LIBDIR)/libplateforce_r.a
PKG_LIBS = -L$(LIBDIR) -lplateforce_r -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

CARGO_HOME_DIR = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/rust/vendor

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB) rust_clean

$(SHLIB): $(STATLIB)

# Two parallel jobs, because cargo otherwise takes every logical CPU and CRAN's policy
# caps what a build may use. CARGO_HOME sits under the build tree so an install writes
# nothing into the user's home.
$(STATLIB):
	if [ -f ./rust/vendor.tar.xz ]; then \
		tar -xf ./rust/vendor.tar.xz -C ./rust; \
		if [ ! -d "$(VENDOR_DIR)" ]; then \
			echo "rust/vendor.tar.xz carries no vendor directory" >&2; \
			exit 1; \
		fi; \
		mkdir -p "$(CARGO_HOME_DIR)" && \
		sed 's|@VENDOR_DIR@|$(VENDOR_DIR)|' ./rust/vendor-config.toml \
			> "$(CARGO_HOME_DIR)/config.toml"; \
	fi
	export CARGO_HOME="$(CARGO_HOME_DIR)" && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	cargo build --lib --release -j 2 \
		--manifest-path=./rust/Cargo.toml --target-dir="$(TARGET_DIR)" @TARGET@

# The static library is an input to the shared object rather than a part of the package,
# and leaving it beside the build is what puts a Rust archive in front of the check that
# reads a shared object's symbols. The rest of the target tree stays, so a rebuild is
# incremental.
rust_clean: $(SHLIB)
	rm -Rf "$(CARGO_HOME_DIR)" "$(VENDOR_DIR)"
	rm -f "$(STATLIB)"

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) "$(TARGET_DIR)" "$(VENDOR_DIR)" "$(CARGO_HOME_DIR)"

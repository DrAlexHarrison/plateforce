target/
__pycache__/
*.pyc
.venv/
*.Rcheck/
.Rhistory
node_modules/
dist/
build/
.DS_Store

# The browser bundle is a build artifact.
web/pkg/

# R CMD build writes the source package beside the repository root.
plateforce_*.tar.gz

# Agent worktrees.
.claude/

# Browser verification artefacts written by an agent looking at the page.
.playwright-mcp/

# Written by the R surface build, and it holds this machine's absolute vendor path, so a
# commit of it would point every other machine at a directory it does not have.
bindings/r/src/.cargo/

# Working notes from a round, never tree content.
*.log

# The guides are rendered from docs/quickstart/ by its own build script, and they reach a
# reader as release assets. The sources and the screenshots they place are tracked; the
# rendered pages are not, for the same reason web/pkg/ is not.
docs/quickstart/*.html
docs/quickstart/*.pdf
docs/quickstart/captured.json

# testthat's failure spool.
bindings/r/tests/testthat/_problems/
bindings/r/tests/testthat/testthat-problems.rds
